# HTML documents: Ensure browsers always validate, apply strict Content-Security-Policy, HTTP security headers, and cache headers
/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ws://localhost:3000 http://localhost:3000 wss://*.up.railway.app https://*.up.railway.app https://*.onrender.com wss://*.onrender.com; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

# Service worker and manifest: Must not be cached by browser HTTP cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/dist/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Static hashed assets (Vite adds content hashes): Cache immutable for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
