# HTML documents: Ensure browsers always validate and never serve stale cached app shells or sensitive pages
/*
  Cache-Control: public, max-age=0, must-revalidate

# Service worker and manifest: Must not be cached by browser HTTP cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/dist/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Static hashed assets (Vite adds content hashes): Cache immutable for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
