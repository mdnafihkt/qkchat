# Server Port (default 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed frontend origins for production CORS (comma-separated list)
# In development, localhost / 127.0.0.1 is automatically allowed.
# In production, set this to your frontend domains:
# ALLOWED_ORIGINS=https://qkchat.netlify.app,https://yourdomain.com
ALLOWED_ORIGINS=
